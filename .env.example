# ─── StudyBuddy — environment variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=studybuddy
POSTGRES_DB=studybuddy

# ── Ollama ────────────────────────────────────────────────────────────────────
# If running Ollama on the host instead of in Docker, set to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h

# Embedding model — bge-m3 produces 1024-dim vectors
EMBED_MODEL=bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=8          # lower if you hit Ollama timeouts

# LLM — pulled on Day 1 but NOT called until Day 2
LLM_MODEL=gemma:2b

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ingest-queue

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Path to the folder watchdog monitors and files are saved to
UPLOAD_DIR=./uploads

# ── Parsing ───────────────────────────────────────────────────────────────────
# Pages with fewer chars than this get OCR'd
OCR_MIN_CHARS=50
# Windows: set this if tesseract is not on PATH
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave empty to disable Sentry entirely — no crash, no-op.
SENTRY_DSN=
